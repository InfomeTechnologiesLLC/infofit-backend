# Copy to .env and fill in. NEVER commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# MySQL (use DATABASE_URL=sqlite:///db.sqlite3 for quick local tests only)
DATABASE_URL=mysql://infome:infome_password@127.0.0.1:3306/infome_fit

# JWT lifetimes (minutes / days)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Set True only behind a trusted reverse proxy that overwrites X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=False

# IVA chat and Lens use the server-side Gemini API. Never put this key in Android.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
USDA_FDC_API_KEY=DEMO_KEY

# Phase 8: Redis for the optional Celery push worker
REDIS_URL=redis://127.0.0.1:6379/0
# Optional Firebase service-account JSON path on the server; never include it in a ZIP or APK.
FIREBASE_CREDENTIALS_FILE=
